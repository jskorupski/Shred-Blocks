{
  "name": "shredblocks-color-jam",
  "version": "1.0.0",
  "private": true,
  "license": "MIT",
  "description": "ShredBlocks: Color Jam — 100% Free, Offline-First 3D Polyomino Color-Sort & Shredder Puzzle PWA (shredblocks.skorupski.org)",
  "homepage": "https://shredblocks.skorupski.org",
  "repository": {
    "type": "git",
    "url": "https://github.com/jskorupski/Shred-Blocks.git"
  },
  "type": "module",
  "scripts": {
    "dev": "./node_modules/.bin/vite --host 127.0.0.1 --port 4173",
    "dev:lan": "./node_modules/.bin/vite --config vite.lan.config.ts",
    "build": "tsc --noEmit && vite build",
    "preview": "./node_modules/.bin/vite preview --host 127.0.0.1 --port 4173",
    "preview:lan": "./node_modules/.bin/vite preview --config vite.lan.config.ts",
    "test:unit": "vitest run tests/unit",
    "test:e2e": "playwright test",
    "verify:visual": "tsx scripts/visual-harness.ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.50.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vitest": "^4.1.12"
  }
}
