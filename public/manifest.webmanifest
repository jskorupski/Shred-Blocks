  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#151226",
  "theme_color": "#151226",
  "categories": ["games", "puzzle"],
  "related_applications": [
    {
      "platform": "webapp",
      "url": "https://shredblocks.skorupski.org/manifest.webmanifest"
    }
  ],
